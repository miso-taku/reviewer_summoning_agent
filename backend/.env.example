# backend/.env.example
# 技術設計書 §10.1 環境変数一覧。実値は .env にコピーして上書き（リポジトリにコミットしないこと: REQ-NF-020）

# ---- CORS（推奨） -------------------------------------------------------------
# カンマ区切りで列挙。Next.js 既定ポートを許可
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---- LLM プロバイダ API キー（実行時必須・いずれか採用） -------------------------
# OpenAI を使う場合
OPENAI_API_KEY=
# Anthropic を使う場合
ANTHROPIC_API_KEY=
# 追加プロバイダで Base URL が必要な場合のみ設定
# LLM_BASE_URL=

# ---- モデル名（任意・ステップごとに分けたい場合） ------------------------------
# 例: gpt-4o-mini / claude-3-5-sonnet-latest など
# LLM_MODEL_SUMMON=
# LLM_MODEL_REVIEW=
# LLM_MODEL_EDITOR=

# ---- ログ（任意） -------------------------------------------------------------
# 既定 INFO。デバッグ時のみ DEBUG（原稿本文はマスク方針: REQ-NF-022）
LOG_LEVEL=INFO
# true のときのみデバッグログに原稿本文を含める（本番では false 推奨）
# LOG_MANUSCRIPT_IN_DEBUG=false

# ---- LLM 呼び出しタイムアウト（任意） ----------------------------------------
# 各 Agent 呼び出しの上限秒数（全体バジェット 170s より短く設定）
# LLM_CALL_TIMEOUT_SECONDS=55
